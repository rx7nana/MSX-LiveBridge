{
  "manifest_version": 3,
  "name": "MSX LiveBridge",
  "version": "1.0.4",
  "description": "msxplayとMSX実機をつなぎます。MSX LiveBridge起動中に自動連携します。",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:27183/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://msxplay.com/*"
      ],
      "js": [
        "main-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://msxplay.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
